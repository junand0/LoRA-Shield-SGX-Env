[libos]
entrypoint = "/workspace/proto/smoke_data/enclave_c"

[loader]
log_level = "error"
insecure__use_cmdline_argv = true

[loader.entrypoint]
uri = "file:/usr/lib/x86_64-linux-gnu/gramine/libsysdb.so"
sha256 = "e6014513d79ba404b73fcb310c619ddba07da66e696398829cd4a9eb3553c6a5"

[loader.env]
LD_LIBRARY_PATH = "/lib:/lib/x86_64-linux-gnu:/usr//lib/x86_64-linux-gnu:/usr/lib:/usr/local/lib"
PATH = "/usr/bin:/bin"
HOME = "/root"

[sys]
enable_sigterm_injection = true

[fs]
mounts = [
    { path = "/lib", uri = "file:/usr/lib/x86_64-linux-gnu/gramine/runtime/glibc" },
    { path = "/lib/x86_64-linux-gnu", uri = "file:/lib/x86_64-linux-gnu" },
    { path = "/usr", uri = "file:/usr" },
    { path = "/etc", uri = "file:/etc" },
    { path = "/workspace", uri = "file:/workspace" },
    { type = "untrusted_shm", path = "/dev/shm", uri = "dev:/dev/shm/" },
]

[sgx]
debug = true
edmm_enable = true
enclave_size = "4G"
max_threads = 32
remote_attestation = "none"
allowed_files = [
    "file:/etc/",
    "file:/usr/local/lib/python3.12/dist-packages/",
    "file:/workspace/proto/",
    "dev:/dev/shm/",
]
isvprodid = 0
isvsvn = 0
enable_stats = false
use_exinfo = false

